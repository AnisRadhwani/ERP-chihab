# ─── Backend API (apps/api) ───────────────────────────────────────
PORT=3000
NODE_ENV=development
USE_MOCK_PROVIDERS=true

# Firebase Admin SDK (backend only — never expose to frontend)
# Option A (recommandée): chemin vers le fichier JSON téléchargé depuis Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: variables individuelles (alternative)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Meta Ads API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Delivery APIs
XDELIVERY_API_KEY=
XDELIVERY_API_URL=
XDELIVERY_COMPANY_ID=

# Optional future delivery providers
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_API_URL=

# ─── Frontend (apps/web) ──────────────────────────────────────────
# Firebase client config (public keys — safe for frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MS=300000
